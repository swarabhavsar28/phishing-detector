# ── Load raw CSV files ────────────────────────────────────────────────────────
df_tx      = pd.read_csv('txs_features.csv')        # 203,769 transaction rows
df_wallets = pd.read_csv('wallets_features.csv')     # 822,942 wallet rows
df_tx_cls  = pd.read_csv('txs_classes.csv')          # illicit=1, licit=2, unknown=3
df_tx_edges    = pd.read_csv('txs_edgelist.csv')     # tx → tx transfers
df_tx_w_edges  = pd.read_csv('txs_wallets_edgelist.csv')  # tx ↔ wallet links

# ── Remap raw Bitcoin IDs to contiguous integers ──────────────────────────────
# Bitcoin txIDs are hex strings — PyG needs 0-indexed integers
tx_id_map  = {v: i for i, v in enumerate(df_tx['txId'].unique())}
w_id_map   = {v: i for i, v in enumerate(df_wallets['walletId'].unique())}

# ── Build edge indices ────────────────────────────────────────────────────────
# Tx → Tx  (transfer_to)
tx_tx_src = torch.tensor([tx_id_map[i] for i in df_tx_edges['txId1']])
tx_tx_dst = torch.tensor([tx_id_map[i] for i in df_tx_edges['txId2']])
tx_tx_ei  = torch.stack([tx_tx_src, tx_tx_dst], dim=0)   # shape [2, E_tt]

# Wallet → Tx  (owns)
w_tx_src = torch.tensor([w_id_map[i]  for i in df_tx_w_edges['walletId']])
w_tx_dst = torch.tensor([tx_id_map[i] for i in df_tx_w_edges['txId']])
w_tx_ei  = torch.stack([w_tx_src, w_tx_dst], dim=0)      # shape [2, E_wt]

# Tx → Wallet  (received_by) — same edges, direction flipped
tx_w_ei  = w_tx_ei.flip(0)                               # shape [2, E_wt]

# ── Sinusoidal degree positional encoding (16-dim) ────────────────────────────
def sinusoidal_degree_pe(edge_index, num_nodes, pe_dim=16):
    deg = torch.zeros(num_nodes)
    deg.scatter_add_(0, edge_index[1], torch.ones(edge_index.shape[1]))
    deg = torch.log1p(deg)                        # log(1 + degree)
    freqs = torch.arange(1, pe_dim // 2 + 1).float()
    angles = deg.unsqueeze(1) * freqs.unsqueeze(0)   # [N, pe_dim//2]
    pe = torch.cat([torch.sin(angles), torch.cos(angles)], dim=1)
    return pe                                     # [N, 16]

tx_pe = sinusoidal_degree_pe(tx_tx_ei, num_nodes=len(tx_id_map))
w_pe  = torch.zeros(len(w_id_map), 16)           # wallets have no W→W edges

# ── Normalise features (fit on train only) ───────────────────────────────────
tx_ts  = df_tx['timestep'].values
tr_mask = (tx_ts >= 1) & (tx_ts <= 34)
scaler  = StandardScaler()
tx_raw  = df_tx.drop(columns=['txId','timestep']).values.astype(np.float32)
tx_raw[tr_mask]  = scaler.fit_transform(tx_raw[tr_mask])
tx_raw[~tr_mask] = scaler.transform(tx_raw[~tr_mask])

# Append PE → final node features
tx_feats_tensor = torch.tensor(
    np.concatenate([tx_raw, tx_pe.numpy()], axis=1))   # [203769, 182]
w_raw = df_wallets.drop(columns=['walletId']).values.astype(np.float32)
w_feats_tensor  = torch.tensor(
    np.concatenate([w_raw, w_pe.numpy()], axis=1))     # [822942, 72]

# ── Assemble HeteroData object ────────────────────────────────────────────────
hdata = HeteroData()

# Node feature stores
hdata['transaction'].x = tx_feats_tensor    # [203769, 182]
hdata['wallet'].x      = w_feats_tensor     # [822942, 72]

# Edge stores — four directed relation types
hdata['transaction', 'transfers_to', 'transaction'].edge_index = tx_tx_ei
hdata['wallet',      'owns',         'transaction'].edge_index = w_tx_ei
hdata['transaction', 'received_by',  'wallet'      ].edge_index = tx_w_ei
hdata['transaction', 'sent_by',      'wallet'      ].edge_index = tx_w_ei.flip(0)
# ↑ sent_by reverses owns: gives explicit Tx→Wallet sender context

